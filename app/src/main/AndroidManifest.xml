<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- אין הרשאת אינטרנט: האפליקציה עובדת אופליין לחלוטין -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- מנהל הקבצים המובנה: גישה לכל הקבצים (אנדרואיד 11+) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- אנדרואיד 8-10 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="resource/folder" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="inode/directory" />
        </intent>
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.android.documentsui" />
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.mi.android.globalFileexplorer" />
        <package android:name="com.android.fileexplorer" />
        <package android:name="com.alphainventor.filemanager" />
        <package android:name="com.amaze.filemanager" />
        <package android:name="nextapp.fx" />
        <package android:name="com.lonelycatgames.Xplore" />
        <package android:name="com.ghisler.android.TotalCommander" />
        <package android:name="com.estrongs.android.pop" />
        <package android:name="pl.solidexplorer2" />
        <package android:name="com.mixplorer" />
        <package android:name="com.mixplorer.silver" />
        <package android:name="com.cxinventor.file.explorer" />
        <package android:name="com.speedsoftware.explorer" />
        <package android:name="org.openintents.filemanager" />
        <package android:name="me.zhanghai.android.files" />
        <package android:name="com.asus.filemanager" />
        <package android:name="com.huawei.hidisk" />
        <package android:name="com.coloros.filemanager" />
        <package android:name="com.oneplus.filemanager" />
        <package android:name="com.vivo.filemanager" />
        <package android:name="com.lenovo.FileBrowser2" />
        <package android:name="com.rhmsoft.fm" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- ספריית הקיצורים -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- מנהל הקבצים המובנה. מופיע גם כאייקון נפרד, וגם ברשימת "פתח באמצעות" של תיקיות -->
        <activity
            android:name=".BrowserActivity"
            android:exported="true"
            android:icon="@mipmap/ic_files"
            android:label="@string/files_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="resource/folder" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.document/directory" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="inode/directory" />
            </intent-filter>
        </activity>

        <!-- יצירת קיצור מתוך "שיתוף" (קישור, טקסט, קובץ) -->
        <activity
            android:name=".EditorActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- פתיחת קובץ קיצור (.linkit) מכל מנהל קבצים -->
        <activity
            android:name=".OpenFileActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-linkit-shortcut" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.linkit" />
                <data android:pathPattern=".*\\..*\\.linkit" />
                <data android:pathPattern=".*\\..*\\..*\\.linkit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.linkit" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme" />

        <!-- מאפשר לפתוח קבצים מהמנהל המובנה באפליקציות אחרות -->
        <provider
            android:name=".FileShareProvider"
            android:authorities="com.lnk.shortcuts.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- LinkIt כ"ספק אחסון": הקיצורים מופיעים כקבצים בתוך מנהלי קבצים -->
        <provider
            android:name=".ShortcutDocsProvider"
            android:authorities="com.lnk.shortcuts.docs"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
